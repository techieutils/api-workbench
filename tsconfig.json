{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node20",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "moduleDetection": "legacy",
    "preserveSymlinks": true
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "packages/api-workbench-common/src/collection-formats/bruno-lang.d.ts"
  ]
}
