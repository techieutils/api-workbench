{
  "name": "@techieutils/api-workbench-app",
  "version": "1.0.0",
  "description": "The API Workbench renderer: Vue 3 and Pinia.",
  "license": "MIT",
  "private": true,
  "exports": {
    "./package.json": "./package.json",
    "./assets/*": "./src/assets/*",
    "./styles/*": "./src/styles/*",
    "./public/*": "./public/*",
    "./editor/runtime": {
      "types": "./src/editor/runtime.ts",
      "source": "./src/editor/runtime.ts"
    },
    "./editor/formatting": {
      "types": "./src/editor/formatting.ts",
      "default": "./dist/node/editor/formatting.js"
    }
  },
  "scripts": {
    "build": "npm run build:shell && npm run build:node && npm run build:styles",
    "build:prod": "npm run build:shell:prod && npm run build:node && npm run build:styles:prod",
    "build:shell": "vite build --mode development --logLevel warn && vite build -c vite.terminal.config.mts --mode development --logLevel warn",
    "build:shell:prod": "vite build --logLevel warn && vite build -c vite.terminal.config.mts --logLevel warn",
    "build:node": "node ../../node_modules/typescript-build/bin/tsc -p tsconfig.node.json",
    "build:styles": "tailwindcss -i src/styles/styles.css -o dist/styles.css",
    "build:styles:prod": "tailwindcss -i src/styles/styles.css -o dist/styles.css --minify",
    "watch:styles": "tailwindcss -i src/styles/styles.css -o dist/styles.css --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "node ../../node_modules/typescript-build/bin/tsc -p tsconfig.spec.json && node --test \"dist-spec/**/*.spec.js\" && vitest run",
    "test:vue": "vitest run",
    "test:vue:watch": "vitest",
    "preview": "python3 -m http.server 4173 --directory dist",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,vue,css,html}\" \"*.{json,mts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,html}\" \"*.{json,mts}\"",
    "clean": "node -e \"for (const d of ['dist', 'dist-spec']) require('fs').rmSync(d, { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@mdi/js": "^7.4.47",
    "@prettier/plugin-xml": "^3.4.2",
    "@tailwindcss/cli": "^4.3.5",
    "@techieutils/api-workbench-common": "1.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "2.5.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "happy-dom": "21.0.4",
    "marked": "18.2.0",
    "pinia": "^4.1.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "vitest": "5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "3.3.13"
  }
}
