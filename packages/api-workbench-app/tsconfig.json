{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "moduleDetection": "legacy"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "../api-workbench-common/src/collection-formats/bruno-lang.d.ts"
  ]
}
