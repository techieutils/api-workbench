{
  "name": "@techieutils/api-workbench-electron",
  "version": "1.0.0",
  "description": "The API Workbench Electron main process: transport, protocols, vault, OAuth, and IPC.",
  "license": "MIT",
  "private": true,
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript-build/bin/tsc -p tsconfig.json",
    "typecheck": "node ../../node_modules/typescript-build/bin/tsc -p tsconfig.spec.json --noEmit",
    "test": "npm --prefix ../api-workbench-common run build && node ../../node_modules/typescript-build/bin/tsc -p tsconfig.spec.json && node --test \"dist-spec/**/*.spec.js\"",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.json\"",
    "clean": "node -e \"for (const d of ['dist', 'dist-spec']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "start": "npm --prefix ../.. start"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1165.0",
    "@aws-sdk/client-ssm": "^3.1165.0",
    "@aws-sdk/credential-providers": "^3.1165.0",
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@techieutils/api-workbench-common": "1.0.0",
    "aedes": "^1.2.0",
    "electron-updater": "^6.8.12",
    "engine.io": "^6.6.11",
    "google-auth-library": "^11.3.4",
    "hash-wasm": "^4.13.0",
    "https-proxy-agent": "^9.1.0",
    "httpsnippet": "^3.0.10",
    "jose": "^6.2.17",
    "mqtt": "^5.16.1",
    "node-pty": "^1.1.0",
    "protobufjs": "^8.8.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "undici": "^8.12.4",
    "ws": "^8.22.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@techieutils/api-workbench-assets": "1.0.0",
    "@types/ws": "^8.18.2"
  }
}
